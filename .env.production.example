# =============================================================================
# CAHAYAOS — TEMPLATE ENVIRONMENT PRODUCTION
# =============================================================================
#
# Salin ke `.env` di server, lalu isi yang bertanda GANTI. Jangan menyalin
# .env dari laptop pengembang: nilainya disetel untuk Laragon dan beberapa di
# antaranya berbahaya kalau ikut terbawa ke server.
#
# Setelah diisi, jalankan `php artisan cahayaos:preflight` untuk memeriksa
# seluruh berkas ini sekaligus.
#
# JANGAN pernah memasukkan berkas .env ke Git.
# =============================================================================

APP_NAME=CahayaOS

# WAJIB 'production'. Nilai 'local' membuat Laravel lebih longgar di beberapa
# tempat dan menandai aplikasi sebagai lingkungan pengembangan.
APP_ENV=production

# WAJIB false. Dengan true, setiap error menampilkan jejak kode LENGKAP
# beserta isi konfigurasi — termasuk kata sandi database — kepada siapa pun
# yang membuka halaman yang gagal. Ini kebocoran paling umum pada aplikasi
# Laravel yang naik ke server.
APP_DEBUG=false

# GANTI: jalankan `php artisan key:generate` di server. JANGAN memakai kunci
# yang sama dengan laptop pengembang — kunci ini yang mengenkripsi sesi dan
# cookie.
APP_KEY=

# GANTI dengan alamat sungguhan, LENGKAP dengan https://
#
# Ini bukan sekadar kosmetik. Seluruh tautan yang dikirim ke luar dibangun
# dari nilai ini: link laporan omzet yang dikirim ke peserta lewat WhatsApp,
# dan halaman Cek Simpanan milik anggota. Kalau tertinggal "localhost",
# setiap tautan yang sudah terkirim ke peserta menjadi tidak bisa dibuka —
# dan tidak ada cara menariknya kembali.
APP_URL=https://GANTI-DENGAN-DOMAIN-ANDA

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# -----------------------------------------------------------------------------
# LOG
# -----------------------------------------------------------------------------
# 'daily' memecah log per hari dan membuang yang lama, jadi berkasnya tidak
# tumbuh tanpa batas sampai memenuhi disk server.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

# 'debug' mencatat setiap kueri dan detail internal. Di server itu berarti
# berkas log raksasa yang ikut memuat data peserta.
LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=GANTI_NAMA_DATABASE

# GANTI: buat pengguna database KHUSUS untuk aplikasi ini, jangan 'root'.
# Beri hak seperlunya saja (SELECT, INSERT, UPDATE, DELETE, dan hak DDL untuk
# menjalankan migration). Akun root yang bocor membuka seluruh server basis
# data, bukan hanya satu aplikasi.
DB_USERNAME=GANTI_PENGGUNA_DATABASE
DB_PASSWORD=GANTI_KATA_SANDI_YANG_KUAT

# -----------------------------------------------------------------------------
# SESI & COOKIE
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

# WAJIB true kalau situsnya memakai HTTPS. Tanpa ini, cookie sesi ikut
# terkirim lewat koneksi HTTP biasa dan bisa dibaca di jaringan yang sama —
# termasuk sesi Admin.
SESSION_SECURE_COOKIE=true

# Menghalangi JavaScript membaca cookie sesi.
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

# -----------------------------------------------------------------------------
# CACHE, ANTREAN, PENYIMPANAN
# -----------------------------------------------------------------------------
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# 'local' = storage/app/private. Bukti laporan omzet dan kuitansi investasi
# disimpan di sini dan TIDAK boleh dipindahkan ke disk publik: keduanya data
# keuangan milik peserta, dan hanya boleh keluar lewat route ber-otorisasi.
FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# EMAIL
# -----------------------------------------------------------------------------
# CahayaOS saat ini TIDAK mengirim email apa pun — reset kata sandi dilakukan
# Admin lewat Manajemen User. 'log' aman dibiarkan sampai ada kebutuhan nyata;
# yang berbahaya justru memasang kredensial SMTP yang tidak pernah dipakai.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@GANTI-DENGAN-DOMAIN-ANDA"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
